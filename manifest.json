{
  "manifest_version": 3,
  "name": "YouTube Transcript Copier",
  "version": "1.1.2",
  "description": "Copy a YouTube transcript with clean, occasional timestamps.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "caption-parser.js",
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "formatter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
